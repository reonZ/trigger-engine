{{#if flavor}}
<div class="flavor">{{flavor}}</div>
{{/if}}
<div class="flexrow" style="gap: 0.3em;" data-tooltip-direction="UP">
    <input type="text" class="token" placeholder="{{@root.i18n "token.placeholder"}}" value="{{token.name}}" disabled />
    <button type="button" class="flex0" data-action="pan-token" {{{@root.i18n.tooltip "pan"}}}>
        <i class="fa-solid fa-expand"></i>
    </button>
    <button type="button" class="flex0" data-action="ping-token" data-tooltip="COMBAT.PingCombatant">
        <i class="fa-solid fa-signal-stream"></i>
    </button>
</div>
<div class="flexrow" style="gap: 0.3em;" data-tooltip-direction="UP">
    <button type="button" data-action="pick-token" {{{@root.i18n.tooltip "pick.info"}}}>
        {{@root.i18n "pick.label"}}
    </button>
    <button type="button" data-action="from-select">
        {{@root.i18n "from-select.label"}}
    </button>
    <button type="button" data-action="from-target">
        {{@root.i18n "from-target.label"}}
    </button>
</div>
