{{#if flavor}}
<div class="flavor">{{flavor}}</div>
{{/if}}
<div class="flexrow" style="gap: 0.3em;" data-tooltip-direction="UP">
    <label class="flexrow" style="gap: 0.3em;">
        X:
        <input type="number" name="x" value="0" min="0">
    </label>
    <label class="flexrow" style="gap: 0.3em;">
        Y:
        <input type="number" name="y" value="0" min="0">
    </label>
    <button type="button" class="flex0" data-action="pan-position" {{{@root.i18n.tooltip "pan"}}}>
        <i class="fa-solid fa-expand"></i>
    </button>
    <button type="button" class="flex0" data-action="ping-position" {{{@root.i18n.tooltip "ping"}}}>
        <i class="fa-solid fa-signal-stream"></i>
    </button>
</div>
<div class="flexrow" style="gap: 0.3em;" data-tooltip-direction="UP">
    <button type="button" data-action="pick-position" {{{@root.i18n.tooltip "pick.info"}}}>
        {{@root.i18n "pick.label"}}
    </button>
    <button type="button" data-action="from-select">
        {{@root.i18n "from-select.label"}}
    </button>
    <button type="button" data-action="from-target">
        {{@root.i18n "from-target.label"}}
    </button>
</div>
